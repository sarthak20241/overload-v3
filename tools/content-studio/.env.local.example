# Copy to .env.local. Every key is optional: a missing channel just shows
# "copy + open" instead of a Post button.

# Which subscription writes by default: claude or codex (ChatGPT). You can also
# switch it on the Setup page. codex is found inside the ChatGPT desktop app.
LLM_PROVIDER=claude
CLAUDE_MODEL=opus
# Blank = codex's own default model.
CODEX_MODEL=
# Optional: a 1-year Claude login so the studio never hits "session expired".
# Create it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the Overload repo. Used to read FEATURES.md and recent commits
# ("what I'm building now"). Defaults to two folders up.
OVERLOAD_REPO=

# X (developer.x.com > your app > Keys and tokens). App permissions must be
# "Read and write" BEFORE you generate the access token.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Optional: post into an X Community (for example Build in Public) by its id.
X_COMMUNITY_ID=

# LinkedIn (linkedin.com/developers > your app). Add the products
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Redirect URL to register: http://localhost:4747/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
